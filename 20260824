import numpy as np

arr = np.arange(1, 13) # 1부터 12까지 1차원 배열 (12개)

# 3행 4열로 차원 변경 (-1을 활용한 자동 열 수 계산)
mat_3x4 = arr.reshape(3, -1)

# 1차원 배열로 평탄화
flat_arr = mat_3x4.flatten()

print("[3x4 형상 변환]:\n", mat_3x4)
print("[1차원 평탄화]:", flat_arr)

